// Cloudflare Workers config for `pnpm release` (scripts/release.mjs stages the site first).
{
  "name": "crosato-arcade",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../.cache/release/site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
