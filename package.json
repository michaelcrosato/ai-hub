{
  "name": "ai-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An arcade wall for a large pile of self-contained, AI-built HTML games.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "scan": "node scripts/scan.mjs",
    "build": "node scripts/scan.mjs",
    "ingest": "node scripts/ingest.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "libraries:sync": "node scripts/vendor-libraries.mjs --refresh",
    "libraries:check": "node scripts/check-libraries.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
