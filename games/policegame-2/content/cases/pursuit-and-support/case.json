        "range": 48,
        "sight": true,
        "onFoot": true
      },
      "once": "chasing"
    },
    "surrender": {
      "effects": [
        {
          "op": "service",
          "id": "encounter.resolve",
          "params": {
            "id": "runner-chase",
            "mode": "surrendered"
          }
        }
      ],
      "requires": {
        "encounter": "runner-chase",
        "phase": "active"
      },
      "message": [
        "Clear instructions",
        "The runner has stopped and is cooperating."
      ],
      "at": {
        "entity": "runner",
        "range": 65,
        "sight": true,
        "onFoot": true
      }
    },
    "catch": {
      "effects": [
        {
          "op": "service",
          "id": "encounter.resolve",
          "params": {
            "id": "runner-chase",
            "mode": "caught"
