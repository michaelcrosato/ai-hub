      "requires": {
        "encounter": "runner-chase",
        "phase": "active"
      },
      "message": [
        "Controlled stop",
        "You reached the runner without a strike or projectile."
      ],
      "at": {
        "entity": "runner",
        "range": 26,
        "sight": true,
        "onFoot": true
      }
    },
