      "effects": [
        {
          "op": "fact",
          "key": "observer-note",
          "value": true
        },
        {
          "op": "evidence",
          "id": "observer-account",
          "operation": "record"
        }
      ],
      "message": [
        "Independent account recorded",
        "Dale confirms the route around the warehouse."
      ]
    },
    "observer-leaves": {
      "once": "observer-left",
      "effects": [
        {
          "op": "entity",
          "id": "observer",
          "set": {
            "active": false
          }
        },
        {
          "op": "fact",
          "key": "observer-left",
          "value": true
        },
        {
          "op": "fact",
          "key": "alternate-lead",
          "value": true
        }
      ],
      "message": [
        "Alternate lead retained",
        "Dale has left. Dispatch preserved the quay camera route as an alternate lead."
      ]
    },
