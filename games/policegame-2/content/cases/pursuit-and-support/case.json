      "requires": {
        "encounter": "runner-chase",
        "phase": "escaped"
      },
      "message": [
        "Record the escape",
        "The failure is recorded honestly. Replay or use the recovery checkpoint to try another approach."
      ],
      "at": {
        "entity": "desk",
        "range": 48,
        "sight": true,
        "onFoot": true
      },
      "once": "closed"
    },
    "restart": {
      "effects": [
        {
          "op": "service",
          "id": "checkpoint.restore",
          "params": {
            "id": "start"
          }
        }
      ],
      "requires": true,
      "message": [
        "Exercise restarted",
        "The initial state and ownership have been restored."
      ]
    },
    "observer-note": {
      "once": "observer-note",
      "at": {
        "entity": "observer",
        "range": 48
      },
      "requires": {
        "not": "observer-left"
