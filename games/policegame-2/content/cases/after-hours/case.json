  "dialogues": {
    "mira-talk": {
      "entry": "account",
      "intentionalLoop": true,
      "nodes": {
        "account": {
          "speaker": "mira",
          "title": "An hour that does not fit",
          "text": [
            {
              "when": "mira-cleared",
              "text": "\u201cThank you for checking. I was beginning to think nobody would believe the work order.\u201d"
            },
            {
              "when": "timeline-compared",
              "text": "\u201cDid the records explain why his clock says I was here after my shift?\u201d"
            },
            {
              "when": true,
              "text": "\u201cI came through at 22:14. My order runs until eleven. Devon says the door says 23:14, but that cannot be right.\u201d"
            }
          ],
          "choices": [
            {
              "id": "account",
              "label": "Listen and record Mira\u2019s account",
              "action": "hear-mira",
              "visible": {
                "not": "mira-heard"
              }
            },
            {
              "id": "clear",
              "label": "Explain the corrected time and clear Mira",
              "action": "clear-mira",
              "visible": {
                "not": "mira-cleared"
              }
            },
            {
              "id": "leave",
              "label": "Return to the scene",
              "close": true
            }
          ]
        }
      }
    },
    "devon-talk": {
      "entry": "account",
      "intentionalLoop": true,
      "nodes": {
        "account": {
          "speaker": "devon",
          "title": "A discrepancy to check",
          "text": "\u201cI saw 23:14 and challenged her. The central register says 22:14 for the same event. I secured the archive so you can check the printout.\u201d",
          "choices": [
            {
              "id": "account",
              "label": "Record Devon\u2019s account",
              "action": "hear-devon",
              "visible": {
                "not": "devon-heard"
              }
            },
            {
              "id": "permission",
              "label": "Request access and the service key",
              "action": "permission",
              "visible": {
                "not": "permission"
              }
            },
            {
              "id": "leave",
              "label": "Return to the scene",
              "close": true
            }
          ]
        }
      }
    },
    "lena-talk": {
      "entry": "account",
      "intentionalLoop": true,
      "nodes": {
        "account": {
          "speaker": "lena",
          "title": "The calibration shift",
          "text": [
            {
              "when": "manual-test",
              "text": "\u201cYes, I used the manual bypass. If it is missing from the log, attach my account. That was my test, not Mira\u2019s.\u201d"
            },
            {
              "when": {
                "evidence": "panel-observation"
              },
              "text": "\u201cYou noticed the selector. I was testing that zone during calibration. Let me explain what I did.\u201d"
            },
            {
              "when": true,
              "text": "\u201cI was calibrating the alarm. I should check the test record before I tell you more.\u201d"
            }
          ],
          "choices": [
            {
              "id": "account",
              "label": "Ask about the calibration work",
              "action": "hear-lena",
              "visible": {
                "not": "lena-heard"
              }
            },
            {
              "id": "bypass",
              "label": "Show the manual-test observation",
              "action": "ask-bypass",
              "visible": {
                "all": [
                  {
                    "evidence": "panel-observation"
                  },
                  {
                    "not": "manual-test"
                  }
                ]
              }
            },
            {
              "id": "leave",
              "label": "Return to the scene",
              "close": true
            }
          ]
        }
      }
    },
    "report": {
      "entry": "account",
      "intentionalLoop": true,
