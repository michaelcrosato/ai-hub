  "start": {
    "scene": "interior-investigation-room",
    "x": 96,
    "y": 192,
    "target": "caretaker"
  },
  "locationRefs": [
    "interior-investigation-room",
    "archive-room"
  ],
  "entities": [
    {
      "id": "caretaker",
      "kind": "person",
      "label": "Mae Collins",
      "scene": "interior-investigation-room",
      "x": 144,
      "y": 176,
      "look": {
        "outfit": "coat",
        "hair": "long",
        "colors": {
          "cloth": "#73876a",
          "coat": "#73876a",
          "pants": "#536064",
          "skin": "#c6a784"
        }
      }
    },
    {
      "id": "archive-door",
      "kind": "door",
      "label": "Locked archive",
      "scene": "interior-investigation-room",
      "x": 224,
      "y": 176,
      "w": 16,
      "d": 32,
      "h": 48
    },
    {
      "id": "desk",
      "kind": "container",
      "label": "Report desk",
      "scene": "interior-investigation-room",
      "x": 272,
      "y": 240
    },
    {
      "id": "cabinet",
      "kind": "container",
      "label": "Archive cabinet",
      "scene": "archive-room",
      "x": 160,
      "y": 144
    },
    {
      "id": "sample",
      "kind": "surface",
      "label": "White powder sample",
      "scene": "archive-room",
      "x": 224,
      "y": 144,
      "visible": "cabinet-searched"
    },
    {
      "id": "wall-mark",
      "kind": "surface",
      "label": "Cleaning label",
      "scene": "archive-room",
      "x": 288,
      "y": 96
    },
    {
      "id": "exit",
      "kind": "anchor",
      "label": "Return to courtyard",
      "scene": "archive-room",
      "x": 96,
      "y": 224
    }
  ],
  "inventory": {
    "camera": {
      "holder": "player",
      "count": 1
    },
    "evidence-kit": {
      "holder": "player",
      "count": 1
    },
    "radio": {
      "holder": "player",
      "count": 1
    },
    "flashlight": {
      "holder": "player",
      "count": 1
    },
    "restraints": {
      "holder": "player",
      "count": 1
    },
    "first-aid": {
      "holder": "player",
      "count": 1
    }
  },
  "actions": {
    "permission": {
      "once": "permission",
      "effects": [
        {
          "op": "fact",
          "key": "permission",
          "value": true
        },
        {
          "op": "grant",
          "item": "archive-key"
        }
      ],
      "message": [
        "Permission granted",
        "Mae gives you the archive key and permission to inspect the cabinet."
      ]
    },
    "interview": {
      "once": "interviewed",
      "requires": "permission",
      "effects": [
        {
          "op": "fact",
          "key": "interviewed",
          "value": true
        }
      ],
      "message": [
        "Account recorded",
        "The caretaker confirms that the white powder was spilled cleaning compound."
      ]
    },
    "enter": {
      "requires": {
        "inventory": {
          "item": "archive-key"
        }
      },
      "effects": [
        {
          "op": "entity",
          "id": "archive-door",
          "set": {
            "open": true
          }
        },
        {
          "op": "transition",
          "scene": "archive-room",
          "anchor": "entry"
        }
      ],
      "message": [
        "Archive opened",
        "The key works. The interior remains part of the same investigation."
      ]
    },
    "leave": {
      "effects": [
        {
          "op": "transition",
          "scene": "interior-investigation-room",
          "anchor": "entry"
        }
      ],
      "message": [
        "Courtyard",
        "The report desk is outside."
      ]
    },
    "search-cabinet": {
      "once": "cabinet-searched",
      "effects": [
        {
          "op": "fact",
          "key": "cabinet-searched",
          "value": true
        },
        {
          "op": "entity",
          "id": "cabinet",
          "set": {
            "open": true
          }
        }
      ],
      "message": [
        "Cabinet searched",
        "A sample packet can be documented and collected."
      ]
    },
    "observe": {
      "once": "observed-mark",
      "effects": [
        {
          "op": "fact",
          "key": "observed-mark",
          "value": true
        }
      ],
      "message": [
        "Cleaning label",
        "The cleaning compound uses the same lot number as the sample."
      ]
    },
    "compare": {
      "once": true,
      "channel": "radio",
      "label": "Request sample comparison",
      "requires": "sample:bag",
      "effects": [
        {
          "op": "job",
          "id": "sample-match"
        }
      ],
      "message": [
        "Lab request queued",
        "The fictional laboratory will compare the sample and cleaning record."
      ]
    },
    "report": {
      "once": "closed",
      "requires": {
        "all": [
          {
            "record": "sample-match"
          },
          {
            "any": [
              "observed-mark",
              "interviewed"
            ]
          }
        ]
      },
      "effects": [
        {
          "op": "fact",
          "key": "closed",
          "value": true
        },
        {
          "op": "resolve",
          "id": "reported"
        }
      ],
      "message": [
        "Report submitted",
        "A verified cleaning spill. No arrest is needed."
      ]
    }
  },
  "evidence": {
    "sample": {
      "title": "White powder sample",
      "number": "E-01",
      "kind": "sample",
      "detail": "A nonhazardous residue sample from the cleaning cupboard. Compare the lot code against the fictional maintenance record.",
      "requires": "cabinet-searched",
      "entity": "sample"
    },
    "comparison": {
      "title": "Sample and maintenance comparison",
      "kind": "comparison",
      "detail": "The sampled residue and maintenance lot are both C-108, a routine cleaning compound. The comparison supports the witness or label account.",
      "requires": {
        "record": "sample-match"
      }
    }
  },
  "interactions": [
    {
      "id": "caretaker",
      "entity": "caretaker",
      "label": "Speak to Mae",
      "dialogue": "permission"
    },
    {
      "id": "enter",
      "entity": "archive-door",
      "label": "Unlock and enter archive",
      "action": "enter"
    },
    {
      "id": "cabinet",
      "entity": "cabinet",
      "label": "Search archive cabinet",
      "action": "search-cabinet",
      "duration": 1,
      "visible": {
        "not": "cabinet-searched"
      }
    },
    {
      "id": "sample",
      "entity": "sample",
      "label": "Inspect sample packet",
      "evidence": "sample",
      "visible": {
        "all": [
          "cabinet-searched",
          {
            "not": "sample:bag"
          }
        ]
      }
    },
    {
      "id": "mark",
      "entity": "wall-mark",
      "label": "Read cleaning label",
      "action": "observe"
    },
    {
      "id": "exit",
      "entity": "exit",
      "label": "Return to courtyard",
      "action": "leave"
    },
    {
      "id": "report",
      "entity": "desk",
      "label": "Submit report",
      "action": "report"
    }
  ],
  "dialogues": {
    "permission": {
      "entry": "account",
      "intentionalLoop": true,
      "nodes": {
        "account": {
          "speaker": "caretaker",
          "title": "The archive caretaker",
          "text": "I can unlock the archive for you. The cleaning cupboard was open earlier.",
          "choices": [
            {
              "id": "permission",
              "label": "Request permission and the archive key",
              "action": "permission"
            },
            {
              "id": "account",
              "label": "Ask about the white powder",
              "action": "interview",
              "requires": "permission"
            },
            {
              "id": "leave",
              "label": "Continue the investigation",
              "close": true
            }
          ]
        }
      }
    }
  },
  "objectives": [
    {
      "id": "permission",
      "step": 1,
      "title": "Get permission",
      "text": "Ask Mae for the archive key. Her account is an alternate lead.",
      "target": "caretaker",
      "complete": "permission"
    },
    {
      "id": "cabinet",
      "step": 2,
      "title": "Search the archive",
      "text": "Unlock the archive, then search its cabinet.",
      "target": "cabinet",
      "complete": "cabinet-searched"
    },
    {
      "id": "sample",
      "step": 3,
      "title": "Preserve the sample",
      "text": "Photograph and collect the sample. Read the label or record Mae’s account.",
      "target": "sample",
      "complete": "sample:bag"
    },
    {
      "id": "comparison",
      "step": 4,
      "title": "Check the lab result",
      "text": "Request a sample comparison over the radio.",
      "target": "sample",
      "complete": {
        "record": "sample-match"
      }
    },
    {
      "id": "report",
      "step": 5,
      "title": "File a supported report",
      "text": "Return outside and submit the record at the desk.",
      "target": "desk",
      "complete": "closed"
    }
  ],
  "invariants": [
    {
      "when": "closed",
      "requires": {
        "all": [
          {
            "record": "sample-match"
          },
          {
            "any": [
              "observed-mark",
              "interviewed"
            ]
          }
        ]
      },
      "reason": "A comparison and independent context are required."
    }
  ],
  "scoring": {
    "categories": {
      "investigation": 10
    },
    "awards": [
      {
        "id": "sample",
        "when": "sample:bag",
        "category": "investigation",
        "points": 5
      },
      {
        "id": "report",
        "when": "closed",
        "category": "investigation",
        "points": 5
      }
    ]
  },
  "outcomes": [
    {
      "id": "reported",
      "title": "A documented explanation",
      "when": "closed",
      "terminal": true,
      "text": "The substance matches cleaning compound. Your account and record support a no-arrest report."
    }
  ],
  "records": {
    "sample-match": {
      "delay": 1.5,
      "title": "Sample comparison complete",
      "text": "The lot code matches routine cleaning compound. The witness or cleaning label confirms its use.",
      "result": {
        "lot": "C-108",
        "match": true,
        "classification": "cleaning compound"
      },
      "effects": [
        {
          "op": "evidence",
          "id": "comparison",
          "operation": "record"
        }
      ]
    }
  },
