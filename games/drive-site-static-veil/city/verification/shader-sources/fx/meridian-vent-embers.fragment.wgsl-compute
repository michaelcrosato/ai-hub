// Three.js r181 - Node System

// global
diagnostic( off, derivative_uniformity );


// structs

struct OutputType {
	@location( 0 ) m0 : vec4<f32>,
	@location( 1 ) m1 : vec4<f32>,
	@location( 2 ) m2 : vec4<f32>,
	@location( 3 ) m3 : vec4<f32>,
	
};
var<private> output : OutputType;

// uniforms

struct NodeBuffer_898Struct {
	value : array< vec4<f32>, 8 >
};
@binding( 0 ) @group( 1 )
var<uniform> NodeBuffer_898 : NodeBuffer_898Struct;
struct objectStruct {
	nodeUniform5 : f32
};
@binding( 1 ) @group( 1 )
var<uniform> object : objectStruct;

// codes


@fragment
fn main( @location( 3 ) @interpolate( flat ) nodeVarying3 : u32,
	@location( 4 ) nodeVarying4 : vec2<f32>,
	@location( 5 ) nodeVarying5 : vec4<f32>,
	@location( 6 ) nodeVarying6 : vec4<f32> ) -> OutputType {

	// vars
	
	var DiffuseColor : vec4<f32>;
	var nodeVar0 : u32;
	var nodeVar1 : u32;
	var nodeVar2 : vec3<f32>;
	var nodeVar3 : f32;
	var Output : vec4<f32>;
	var nodeVar4 : vec4<f32>;
	var nodeVar5 : vec4<f32>;
	var nodeVar6 : vec4<f32>;


	// flow
	// code

	nodeVar0 = ( ( ( ( nodeVarying3 + 3529880742u ) + 101u ) * 747796405u ) + 2891336453u );
	nodeVar1 = ( ( ( nodeVar0 >> ( ( nodeVar0 >> 28u ) + 4u ) ) ^ nodeVar0 ) * 277803737u );
	nodeVar2 = ( vec3<f32>( 1.0, ( ( ( f32( ( ( nodeVar1 >> 22u ) ^ nodeVar1 ) ) * 2.3283064365386963e-10 ) * 0.35 ) + 0.42 ), 0.12 ) * vec3<f32>( 2.4 ) );
	DiffuseColor = vec4<f32>( nodeVar2, 1.0 );
	nodeVar3 = ( ( ( ( 1.0 - smoothstep( 0.1, 0.5, length( ( nodeVarying4 - vec2<f32>( 0.5 ) ) ) ) ) * ( 1.0 - clamp( ( nodeVarying5.w / nodeVarying6.w ), 0.0, 1.0 ) ) ) * NodeBuffer_898.value[ ( nodeVarying3 % 8u ) ].w ) * 0.9 );
	DiffuseColor.w = ( DiffuseColor.w * nodeVar3 );

	if ( ( DiffuseColor.w <= object.nodeUniform5 ) ) {

		discard;
		

	}

	Output = max( vec4<f32>( DiffuseColor.xyz, DiffuseColor.w ), vec4<f32>( 0.0 ) );
	output.m0 = Output;
	nodeVar4 = vec4<f32>( 0.0, 0.0, 1.0, nodeVar3 );
	output.m1 = nodeVar4;
	nodeVar5 = vec4<f32>( 0.0, 0.0, 0.0, nodeVar3 );
	output.m2 = nodeVar5;
	nodeVar6 = vec4<f32>( nodeVar2, nodeVar3 );
	output.m3 = nodeVar6;

	// result

	return output;

}
