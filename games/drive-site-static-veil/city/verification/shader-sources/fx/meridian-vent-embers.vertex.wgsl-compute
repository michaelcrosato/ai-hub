// Three.js r181 - Node System

// directives


// structs


// uniforms

struct renderStruct {
	cameraProjectionMatrix : mat4x4<f32>,
	cameraViewMatrix : mat4x4<f32>
};
@binding( 0 ) @group( 0 )
var<uniform> render : renderStruct;

struct objectStruct {
	nodeUniform8 : mat4x4<f32>,
	nodeUniform9 : f32,
	nodeUniform10 : vec2<f32>
};
@binding( 2 ) @group( 1 )
var<uniform> object : objectStruct;

// varyings

struct VaryingsStruct {
	@location( 3 ) @interpolate( flat ) nodeVarying3 : u32,
	@location( 4 ) nodeVarying4 : vec2<f32>,
	@location( 5 ) nodeVarying5 : vec4<f32>,
	@location( 6 ) nodeVarying6 : vec4<f32>,
	@builtin( position ) Vertex : vec4<f32>
};
var<private> varyings : VaryingsStruct;

// codes


@vertex
fn main( @builtin( instance_index ) instanceIndex : u32,
	@location( 0 ) position : vec3<f32>,
	@location( 1 ) uv : vec2<f32>,
	@location( 2 ) nodeAttribute0 : vec4<f32>,
	@location( 3 ) nodeAttribute1 : vec4<f32>,
	@location( 4 ) nodeAttribute2 : vec4<f32>,
	@location( 5 ) nodeAttribute3 : vec4<f32> ) -> VaryingsStruct {

	// vars
	
	var modelViewMatrix : mat4x4<f32>;
	var nodeVar7 : vec4<f32>;
	var nodeVar8 : f32;
	var nodeVar9 : f32;
	var nodeVar10 : u32;
	var nodeVar11 : u32;
	var nodeVar12 : vec4<f32>;
	var positionLocal : vec3<f32>;
	var v_modelViewProjection : vec4<f32>;
	var v_positionView : vec4<f32>;


	// flow
	// code

	positionLocal = position;
	positionLocal = nodeAttribute0.xyz;
	varyings.nodeVarying3 = instanceIndex;
	varyings.nodeVarying4 = uv;
	varyings.nodeVarying5 = nodeAttribute0;
	varyings.nodeVarying6 = nodeAttribute3;
	modelViewMatrix = ( render.cameraViewMatrix * object.nodeUniform8 );
	nodeVar7 = ( modelViewMatrix * vec4<f32>( nodeAttribute0.xyz, 1.0 ) );
	nodeVar8 = cos( object.nodeUniform9 );
	nodeVar9 = sin( object.nodeUniform9 );
	nodeVar10 = ( ( ( instanceIndex + 3529880742u ) * 747796405u ) + 2891336453u );
	nodeVar11 = ( ( ( nodeVar10 >> ( ( nodeVar10 >> 28u ) + 4u ) ) ^ nodeVar10 ) * 277803737u );
	v_positionView = vec4<f32>( ( nodeVar7.xy + ( mat2x2<f32>( nodeVar8, nodeVar9, ( - nodeVar9 ), nodeVar8 ) * ( ( position.xy - ( object.nodeUniform10 - vec2<f32>( 0.5 ) ) ) * ( vec2<f32>( length( object.nodeUniform8[ 0u ].xyz ), length( object.nodeUniform8[ 1u ].xyz ) ) * vec2<f32>( ( ( ( f32( ( ( nodeVar11 >> 22u ) ^ nodeVar11 ) ) * 2.3283064365386963e-10 ) * 0.035 ) + 0.035 ) ) ) ) ) ), nodeVar7.zw );
	nodeVar12 = ( render.cameraProjectionMatrix * v_positionView );
	v_modelViewProjection = nodeVar12;

	// result

	varyings.Vertex = v_modelViewProjection;

	return varyings;

}
