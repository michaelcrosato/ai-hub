// Three.js r181 - Node System

// global
diagnostic( off, derivative_uniformity );


// structs

struct OutputType {
	@location( 0 ) m0 : vec4<f32>,
	@location( 1 ) m1 : vec4<f32>,
	@location( 2 ) m2 : vec4<f32>,
	@location( 3 ) m3 : vec4<f32>,
	
};
var<private> output : OutputType;

// uniforms

struct objectStruct {
	nodeUniform4 : f32,
	nodeUniform5 : f32
};
@binding( 0 ) @group( 1 )
var<uniform> object : objectStruct;

// codes


@fragment
fn main( @location( 3 ) nodeVarying3 : vec2<f32> ) -> OutputType {

	// vars
	
	var DiffuseColor : vec4<f32>;
	var nodeVar12 : vec2<f32>;
	var nodeVar13 : f32;
	var Output : vec4<f32>;
	var nodeVar14 : vec4<f32>;
	var nodeVar15 : vec4<f32>;
	var nodeVar16 : vec4<f32>;


	// flow
	// code

	DiffuseColor = vec4<f32>( vec3<f32>( 0.49, 0.76, 0.85 ), 1.0 );
	nodeVar12 = ( nodeVarying3 - vec2<f32>( 0.5 ) );
	nodeVar13 = ( ( ( ( 1.0 - smoothstep( 0.05, 0.5, abs( nodeVar12.x ) ) ) * ( 1.0 - smoothstep( 0.22, 0.5, abs( nodeVar12.y ) ) ) ) * object.nodeUniform4 ) * 0.28 );
	DiffuseColor.w = ( DiffuseColor.w * nodeVar13 );

	if ( ( DiffuseColor.w <= object.nodeUniform5 ) ) {

		discard;
		

	}

	Output = max( vec4<f32>( DiffuseColor.xyz, DiffuseColor.w ), vec4<f32>( 0.0 ) );
	output.m0 = Output;
	nodeVar14 = vec4<f32>( 0.0, 0.0, 1.0, nodeVar13 );
	output.m1 = nodeVar14;
	nodeVar15 = vec4<f32>( 0.0, 0.0, 0.0, nodeVar13 );
	output.m2 = nodeVar15;
	nodeVar16 = vec4<f32>( ( vec3<f32>( 0.49, 0.76, 0.85 ) * vec3<f32>( 0.03 ) ), nodeVar13 );
	output.m3 = nodeVar16;

	// result

	return output;

}
