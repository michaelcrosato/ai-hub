// Three.js r181 - Node System

// global
diagnostic( off, derivative_uniformity );


// structs

struct OutputType {
	@location( 0 ) m0 : vec4<f32>,
	@location( 1 ) m1 : vec4<f32>,
	@location( 2 ) m2 : vec4<f32>,
	@location( 3 ) m3 : vec4<f32>,
	
};
var<private> output : OutputType;

// uniforms

struct objectStruct {
	nodeUniform2 : f32,
	nodeUniform3 : f32
};
@binding( 0 ) @group( 1 )
var<uniform> object : objectStruct;

// codes


@fragment
fn main( @location( 3 ) nodeVarying3 : vec2<f32> ) -> OutputType {

	// vars
	
	var DiffuseColor : vec4<f32>;
	var nodeVar1 : vec2<f32>;
	var nodeVar2 : f32;
	var Output : vec4<f32>;
	var nodeVar3 : vec4<f32>;
	var nodeVar4 : vec4<f32>;
	var nodeVar5 : vec4<f32>;


	// flow
	// code

	DiffuseColor = vec4<f32>( vec3<f32>( 0.49, 0.76, 0.85 ), 1.0 );
	nodeVar1 = ( nodeVarying3 - vec2<f32>( 0.5 ) );
	nodeVar2 = ( ( ( ( 1.0 - smoothstep( 0.05, 0.5, abs( nodeVar1.x ) ) ) * ( 1.0 - smoothstep( 0.22, 0.5, abs( nodeVar1.y ) ) ) ) * object.nodeUniform2 ) * 0.28 );
	DiffuseColor.w = ( DiffuseColor.w * nodeVar2 );

	if ( ( DiffuseColor.w <= object.nodeUniform3 ) ) {

		discard;
		

	}

	Output = max( vec4<f32>( DiffuseColor.xyz, DiffuseColor.w ), vec4<f32>( 0.0 ) );
	output.m0 = Output;
	nodeVar3 = vec4<f32>( 0.0, 0.0, 1.0, nodeVar2 );
	output.m1 = nodeVar3;
	nodeVar4 = vec4<f32>( 0.0, 0.0, 0.0, nodeVar2 );
	output.m2 = nodeVar4;
	nodeVar5 = vec4<f32>( ( vec3<f32>( 0.49, 0.76, 0.85 ) * vec3<f32>( 0.03 ) ), nodeVar2 );
	output.m3 = nodeVar5;

	// result

	return output;

}
