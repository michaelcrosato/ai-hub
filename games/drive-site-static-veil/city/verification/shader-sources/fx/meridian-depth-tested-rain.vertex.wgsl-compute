// structs


// uniforms

struct objectStruct {
	nodeUniform1 : vec3<f32>,
	nodeUniform6 : mat4x4<f32>,
	nodeUniform7 : vec2<f32>,
	nodeUniform8 : vec2<f32>
};
@binding( 1 ) @group( 1 )
var<uniform> object : objectStruct;

struct renderStruct {
	cameraProjectionMatrix : mat4x4<f32>,
	cameraViewMatrix : mat4x4<f32>
};
@binding( 0 ) @group( 0 )
var<uniform> render : renderStruct;

// varyings

struct VaryingsStruct {
	@location( 3 ) nodeVarying3 : vec2<f32>,
	@builtin( position ) Vertex : vec4<f32>
};
var<private> varyings : VaryingsStruct;

// codes


@vertex
fn main( @builtin( instance_index ) instanceIndex : u32,
	@location( 0 ) position : vec3<f32>,
	@location( 1 ) uv : vec2<f32>,
	@location( 2 ) nodeAttribute0 : vec3<f32> ) -> VaryingsStruct {

	// vars
	
	var nodeVar0 : vec3<f32>;
	var modelViewMatrix : mat4x4<f32>;
	var nodeVar6 : vec4<f32>;
	var nodeVar7 : f32;
	var nodeVar8 : f32;
	var nodeVar9 : u32;
	var nodeVar10 : u32;
	var nodeVar11 : vec4<f32>;
	var positionLocal : vec3<f32>;
	var v_modelViewProjection : vec4<f32>;
	var v_positionView : vec4<f32>;


	// flow
	// code

	positionLocal = position;
	nodeVar0 = ( nodeAttribute0 + object.nodeUniform1 );
	positionLocal = nodeVar0;
	varyings.nodeVarying3 = uv;
	modelViewMatrix = ( render.cameraViewMatrix * object.nodeUniform6 );
	nodeVar6 = ( modelViewMatrix * vec4<f32>( nodeVar0, 1.0 ) );
	nodeVar7 = cos( ( atan2( ( render.cameraViewMatrix * vec4<f32>( object.nodeUniform7.x, object.nodeUniform7.y, -24.0, 0.0 ) ).xy.y, ( render.cameraViewMatrix * vec4<f32>( object.nodeUniform7.x, object.nodeUniform7.y, -24.0, 0.0 ) ).xy.x ) - 1.5707963267948966 ) );
	nodeVar8 = sin( ( atan2( ( render.cameraViewMatrix * vec4<f32>( object.nodeUniform7.x, object.nodeUniform7.y, -24.0, 0.0 ) ).xy.y, ( render.cameraViewMatrix * vec4<f32>( object.nodeUniform7.x, object.nodeUniform7.y, -24.0, 0.0 ) ).xy.x ) - 1.5707963267948966 ) );
	nodeVar9 = ( ( ( ( instanceIndex + 3529880742u ) + 997u ) * 747796405u ) + 2891336453u );
	nodeVar10 = ( ( ( nodeVar9 >> ( ( nodeVar9 >> 28u ) + 4u ) ) ^ nodeVar9 ) * 277803737u );
	v_positionView = vec4<f32>( ( nodeVar6.xy + ( mat2x2<f32>( nodeVar7, nodeVar8, ( - nodeVar8 ), nodeVar7 ) * ( ( position.xy - ( object.nodeUniform8 - vec2<f32>( 0.5 ) ) ) * ( vec2<f32>( length( object.nodeUniform6[ 0u ].xyz ), length( object.nodeUniform6[ 1u ].xyz ) ) * vec2<f32>( 0.022, ( ( ( ( f32( ( ( nodeVar10 >> 22u ) ^ nodeVar10 ) ) * 2.3283064365386963e-10 ) * 0.25 ) + 0.48 ) * clamp( ( length( ( render.cameraViewMatrix * vec4<f32>( object.nodeUniform7.x, object.nodeUniform7.y, -24.0, 0.0 ) ).xy ) / 24.0 ), 0.08, 1.0 ) ) ) ) ) ) ), nodeVar6.zw );
	nodeVar11 = ( render.cameraProjectionMatrix * v_positionView );
	v_modelViewProjection = nodeVar11;

	// result

	varyings.Vertex = v_modelViewProjection;

	return varyings;

}
